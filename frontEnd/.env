# ===================================================
# Backend API Configuration
# ===================================================
# Update the IP address below when the EC2 instance
# gets a new public IP after a reboot.
#
# After changing this file, restart the frontend
# dev server (npm run dev) for changes to take effect.
# ===================================================

# --- For AWS EC2 deployment ---
# Replace the IP with your current EC2 public IP
VITE_MCP_SERVER_URL=http://16.171.200.101:8090
VITE_MCP_CLIENT_URL=http://16.171.200.101:8080

# --- For local development (uncomment below, comment above) ---
# VITE_MCP_SERVER_URL=http://localhost:8090
# VITE_MCP_CLIENT_URL=http://localhost:8080
